<?xml version="1.0" encoding="UTF-8"?>
<!--
  Multilingual string registration for WPML and Polylang (both read this
  file). The texts a site owner types — per-provider notice and button
  overrides on the Providers tab, and the per-block texts set in the block
  editor — become translatable instead of showing in one language on every
  translation. Nothing here is loaded from anywhere: the file only names
  option keys and block attributes.
-->
<wpml-config>
	<admin-texts>
		<key name="calucon_embed_gate_options">
			<key name="providers">
				<key name="*">
					<key name="note" />
					<key name="action" />
					<key name="privacy_url" />
				</key>
			</key>
			<key name="custom_providers">
				<key name="*">
					<key name="label" />
				</key>
			</key>
		</key>
	</admin-texts>
	<gutenberg-blocks>
		<gutenberg-block type="core/embed" translate="1">
			<key name="caluconEmbedGateAction" />
			<key name="caluconEmbedGateNote" />
		</gutenberg-block>
		<gutenberg-block type="core/html" translate="1">
			<key name="caluconEmbedGateAction" />
			<key name="caluconEmbedGateNote" />
		</gutenberg-block>
		<gutenberg-block type="core/video" translate="1">
			<key name="caluconEmbedGateAction" />
			<key name="caluconEmbedGateNote" />
		</gutenberg-block>
		<gutenberg-block type="core/audio" translate="1">
			<key name="caluconEmbedGateAction" />
			<key name="caluconEmbedGateNote" />
		</gutenberg-block>
	</gutenberg-blocks>
</wpml-config>
